# Скопируй в .env и впиши свои данные.
# Координаты точки доставки (можно взять в Google Maps: правый клик → координаты).
EATY_LAT=41.7151
EATY_LON=44.8271
# Либо адрес — тогда координаты найдутся через OpenStreetMap.
# EATY_ADDRESS=Rustaveli Ave 12, Tbilisi

# Необязательно: значения по умолчанию.
# EATY_RADIUS_KM=1.0
# EATY_MIN_SCORE=9.0
