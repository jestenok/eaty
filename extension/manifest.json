{
  "manifest_version": 3,
  "name": "eaty: заказы из Wolt",
  "version": "0.6.2",
  "description": "Пересылает продукты из твоих заказов Wolt в твой аккаунт eaty. Токены и cookie Wolt не читает.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.ts.net/*",
    "https://eaty.lol/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wolt.com/*"
      ],
      "js": [
        "extract.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wolt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://eaty.lol/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "eaty",
    "default_popup": "popup.html"
  }
}
